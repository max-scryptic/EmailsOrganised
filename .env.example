# Copy to .env.local and fill in. Every value is optional: with an empty file
# the template runs against mock auth and mock billing.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Absolute base URL Stripe redirects back to after Checkout and the portal.
# Must be the deployed origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth (Supabase + Google SSO)
# ---------------------------------------------------------------------------
# Leave these empty and the app still boots: Proxy stops guarding routes and
# the sign-in page renders an "auth is not configured" notice.
#
# All three come from Project Settings -> API Keys in the Supabase dashboard.
# The URL is on that page too, and is just https://<project-ref>.supabase.co.
NEXT_PUBLIC_SUPABASE_URL=

# Client-safe. Prefer the modern publishable key (sb_publishable_...); the
# legacy JWT anon key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never expose it to the browser and never prefix
# it with NEXT_PUBLIC_. Used to write Google refresh tokens in the OAuth
# callback, which the signed-in user is deliberately not allowed to do.
# Modern secret key (sb_secret_...); the legacy JWT service_role key also works
# via SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# The same OAuth client you paste into Supabase -> Authentication -> Providers
# -> Google. The app needs its own copy to refresh Gmail access tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Classification (OpenAI)
# ---------------------------------------------------------------------------
# The model call behind a workflow's classification node. Leave the key empty
# and the builder still works — running a classification is the only thing that
# needs it, and it says so rather than failing quietly.
OPENAI_API_KEY=

# Optional. The classification is one short label from a closed set, and the
# answer is constrained by a JSON schema rather than by prompting, so the
# cheapest capable model is the right default.
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini

# Optional. Points the call at an OpenAI-compatible gateway instead of
# https://api.openai.com/v1 — a proxy, or a stub while developing.
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------
# "mock" (default) or "stripe". Switching to "stripe" makes /plans and the
# billing portal call the real API instead of the in-memory mock.
NEXT_PUBLIC_BILLING_PROVIDER=mock

# Stripe secret key. Test mode keys start with sk_test_.
STRIPE_SECRET_KEY=

# Signing secret for /api/billing/webhook. Locally, `stripe listen` prints one;
# in production it comes from the endpoint you create in the dashboard.
STRIPE_WEBHOOK_SECRET=

# Recurring price IDs (price_...), one per plan in `plans` in
# src/lib/template-data.ts. Test mode and live mode have different IDs.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# The Scale plan is sales-led in the template, so it needs no price ID until
# it becomes self-serve.
STRIPE_PRICE_SCALE=
